#include <bits/stdc++.h>
using namespace std;
int main(){
    int a=642587;
    int n=11612;
    vector<int>num;
    num.push_back(1);
    while(n--){
        int carry=0;
        for(int i=0;i<num.size();i++) {
            int x=num[i]*a+carry;
            num[i]= x%10;
            carry= x/10;
        }
        while(carry){
            num.push_back(carry%10);
            carry/=10;
        }
    }
    for(int i=num.size()-1;i>=0;i--)
        cout<<num[i];
    return 0;
}
